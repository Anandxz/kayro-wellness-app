# REQUIRED SERVER-ONLY VARIABLES. Never use NEXT_PUBLIC_ prefixes.
# Supabase project origin only (HTTPS in hosted environments), no /rest/v1 suffix.
SUPABASE_URL=
# Server sb_secret_ API key preferred; legacy service_role JWT accepted.
# Publishable/anon keys are rejected. Keep this out of client code and Git.
SUPABASE_SECRET_KEY=
# Random 32+ characters, stable across deployments to retain workspace cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEMO_SESSION_SECRET=
# Exact browser origin, no path. Vercel must use your HTTPS public domain.
# Set separately for Production/Preview; the app never trusts arbitrary hosts.
APP_ORIGIN=http://localhost:3000

# OPTIONAL TEST-ONLY VARIABLES (not required in Vercel/runtime):
# KAYRO_TEST_ORIGIN=http://localhost:3000
# TEST_DATABASE_URL=  # Empty disposable PostgreSQL DB only; never production.
